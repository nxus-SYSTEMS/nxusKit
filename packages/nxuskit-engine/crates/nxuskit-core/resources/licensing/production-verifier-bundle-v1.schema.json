{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nxus.systems/contracts/licensing/production-verifier-bundle-v1.schema.json",
  "title": "ProductionVerifierBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "provenance",
    "current_key_comparison",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": "nxus-licensing-production-verifier-bundle/v1"
    },
    "bundle_id": {
      "const": "nxus-licensing-production-verifier-bundle-v1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager_decision",
        "devops_authority_commit",
        "provider",
        "key_resource",
        "permitted_operations",
        "retained_selection"
      ],
      "properties": {
        "manager_decision": {"const": "D-C9-W540-PRODUCTION-VERIFIER-BUNDLE-INPUT"},
        "devops_authority_commit": {"const": "e4b815077685f3a356cc8750fabddb810d210ed9"},
        "provider": {"const": "Google Cloud KMS"},
        "key_resource": {"const": "projects/nxus-licensing-prod/locations/us-central1/keyRings/licensing-signing/cryptoKeys/license-token-signing"},
        "permitted_operations": {
          "type": "array",
          "const": ["versions_list", "get_public_key"]
        },
        "retained_selection": {"type": "string", "minLength": 1}
      }
    },
    "current_key_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "reference_pem_sha256", "bundle_kid", "result"],
      "properties": {
        "reference": {"const": "DevOps/sharedData/keys/es256-production-pubkey.pem"},
        "reference_pem_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bundle_kid": {"type": "string", "pattern": "^projects/nxus-licensing-prod/locations/us-central1/keyRings/licensing-signing/cryptoKeys/license-token-signing/cryptoKeyVersions/[0-9]+$"},
        "result": {"const": "byte_identical"}
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kid", "state", "algorithm", "protection_level", "pem_path", "pem_sha256"],
        "properties": {
          "kid": {"type": "string", "pattern": "^projects/nxus-licensing-prod/locations/us-central1/keyRings/licensing-signing/cryptoKeys/license-token-signing/cryptoKeyVersions/[0-9]+$"},
          "state": {"const": "ENABLED"},
          "algorithm": {"const": "EC_SIGN_P256_SHA256"},
          "protection_level": {"const": "SOFTWARE"},
          "pem_path": {"type": "string", "pattern": "^production-verifier-bundle-v1/[a-z0-9-]+\\.pem$"},
          "pem_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
